---
// Layered, contour-lined ridgelines. Far layers drift slower than near ones
// as the page scrolls (parallax). Colours come from CSS custom properties so
// the same component can be tinted per category.
import { makeRidges, makeValleyRidges, type ValleyLayer } from '../lib/ridges';

interface Props {
  seed?: number;
  layers?: number;
  /** Tint mixed into the ridges, e.g. a category colour */
  tint?: string;
  class?: string;
  top?: number;
  bottom?: number;
  intro?: boolean;
  /** viewBox height; match roughly the aspect of the container (width is 1600) */
  height?: number;
  /** Move layers at different speeds while scrolling */
  parallax?: boolean;
  /** 'generated' rolls random hills from the seed; 'swansea-valley' draws the view up Cwm Tawe */
  scene?: 'generated' | 'swansea-valley';
}

const { seed = 7, layers = 5, tint, class: className, top, bottom, intro = false, height = 900, parallax = true, scene = 'generated' } = Astro.props;
const W = 1600;
const valley = scene === 'swansea-valley';
// The valley scene is drawn on a fixed 1600×900 canvas.
const H = valley ? 900 : height;
const ridges: (Omit<ValleyLayer, 'extras' | 'windows' | 'labels'> & Partial<ValleyLayer>)[] = valley
  ? makeValleyRidges()
  : makeRidges({ width: W, height: H, layers, seed, top, bottom });
const n = ridges.length;
const style = tint ? `--tint:${tint}` : undefined;
---
<svg
  class:list={['ridges', className, { intro }]}
  viewBox={`0 0 ${W} ${H}`}
  preserveAspectRatio="xMidYMax slice"
  aria-hidden="true"
  style={style}
  data-parallax={parallax ? '' : undefined}
  data-fit={valley ? '' : undefined}
>
  {ridges.map((r, i) => (
    <g class="ridge" data-depth={r.depth.toFixed(3)} style={`--i:${i};--n:${n}`}>
      <g class="ridge-in">
        <path class="ridge-fill" d={r.fill} />
        {r.extras?.map((d) => <path class="ridge-fill" d={d} />)}
        {r.windows?.map(([x, y]) => <rect class="ridge-window" x={x} y={y} width="5" height="6" />)}
        {r.contours.map((d) => <path class="ridge-contour" d={d} />)}
        {r.labels?.map((l) => (
          <g class="hill-label" data-x={l.x} style={`transform-origin:${l.x}px ${l.y}px`}>
            <line x1={l.x} y1={l.y - 6} x2={l.x} y2={l.y - 34} />
            <text x={l.x} y={l.y - 58} text-anchor="middle">
              {l.name}
              <tspan x={l.x} dy="18">{l.note}</tspan>
            </text>
          </g>
        ))}
      </g>
    </g>
  ))}
</svg>

<script>
  // Fit a fixed scene (the Swansea Valley) to its box. Plain `slice` scaling crops
  // the sides whenever the box is narrower than 16:9, which loses the outer hills.
  // Instead, stretch the scene horizontally by up to MIN–MAX to absorb most of the
  // difference, and only crop what's left over: the sides on very narrow screens,
  // the top of the sky on very wide ones. Labels are counter-scaled in CSS.
  const MIN = 0.7;
  const MAX = 1.5;
  for (const svg of document.querySelectorAll<SVGSVGElement>('svg[data-fit]')) {
    const [, , W, H] = svg.getAttribute('viewBox')!.split(/\s+/).map(Number);
    const design = W / H;
    const fit = () => {
      const { width, height } = svg.getBoundingClientRect();
      if (!width || !height) return;
      const aspect = width / height;
      const stretch = Math.min(MAX, Math.max(MIN, aspect / design));
      const unstretched = aspect / stretch;
      let vx = 0, vy = 0, vw = W, vh = H;
      if (unstretched < design) {
        vw = H * unstretched;
        vx = (W - vw) / 2;
      } else {
        vh = W / unstretched;
        vy = H - vh;
      }
      svg.setAttribute('preserveAspectRatio', 'none');
      svg.setAttribute('viewBox', `${vx.toFixed(1)} ${vy.toFixed(1)} ${vw.toFixed(1)} ${vh.toFixed(1)}`);
      svg.style.setProperty('--stretch', stretch.toFixed(4));
      // Hide any label that would be cut off by the crop rather than show half of it.
      for (const label of svg.querySelectorAll<SVGGElement>('.hill-label')) {
        const x = Number(label.dataset.x);
        const half = label.getBBox().width / 2 / stretch;
        label.classList.toggle('clipped', x - half < vx || x + half > vx + vw);
      }
    };
    fit();
    new ResizeObserver(fit).observe(svg);
  }
</script>

<style>
  .ridges {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    pointer-events: none;
    --tint: var(--haze);
  }
  .ridge {
    will-change: transform;
    /* Far layers are lighter (atmospheric perspective), near layers darker. */
    --mix: calc(var(--i) / (var(--n) - 1) * 100%);
  }
  .ridge-fill {
    fill: color-mix(in oklab, var(--ridge-near) var(--mix), color-mix(in oklab, var(--tint) 35%, var(--ridge-far)));
  }
  .ridge-contour {
    fill: none;
    stroke: color-mix(in oklab, var(--tint) 30%, white);
    stroke-opacity: calc(0.22 - var(--i) * 0.03);
    stroke-width: 1.2;
    vector-effect: non-scaling-stroke;
  }
  .ridge-window {
    fill: #e5a15a;
    opacity: 0.75;
  }
  .hill-label {
    /* Undo the horizontal stretch from the fit script so text keeps its shape. */
    transform: scale(calc(1 / var(--stretch, 1)), 1);
    transform-box: view-box;
  }
  .hill-label line {
    stroke: #f2f6f4;
    stroke-opacity: 0.45;
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }
  .hill-label text {
    font-family: var(--font-display);
    font-size: 17px;
    letter-spacing: 0.06em;
    fill: #f2f6f4;
    opacity: 0.85;
  }
  .hill-label tspan {
    font-size: 14px;
    opacity: 0.75;
  }
  /* Visitors can hide the names; the choice is set on <html> before paint. */
  :global(.hill-names-off) .hill-label,
  .hill-label.clipped { display: none; }
  .intro .ridge-in {
    animation: rise 1.4s cubic-bezier(0.2, 0.7, 0.1, 1) both;
    animation-delay: calc((var(--n) - var(--i)) * 110ms);
  }
  @keyframes rise {
    from { transform: translateY(120px); opacity: 0; }
    to { transform: none; opacity: 1; }
  }
  @media (prefers-reduced-motion: reduce) {
    .ridge-window {
    fill: #e5a15a;
    opacity: 0.75;
  }
  .intro .ridge-in { animation: none; }
  }
</style>
