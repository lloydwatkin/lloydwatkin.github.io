---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageBanner from '../../components/PageBanner.astro';
import PostList from '../../components/PostList.astro';
import CategoryTrail from '../../components/CategoryTrail.astro';
import { getPosts } from '../../lib/content';

const posts = await getPosts();
const years = [...new Set(posts.map((p) => p.data.date.getUTCFullYear()))];
---
<BaseLayout title="Writing" description="Everything I have written, newest first." overlayHeader>
  <PageBanner seed={42}>
    <h1 class="page-title">Writing</h1>
    <p class="page-sub">Everything, newest first. Pick a category to narrow it down.</p>
  </PageBanner>

  <div class="wrap trail-wrap"><CategoryTrail /></div>

  <div class="wrap">
    {posts.length === 0 && <p>Nothing published yet. Add a Markdown file to src/content/posts to get started.</p>}
    {years.map((year) => (
      <section class="year" aria-labelledby={`y${year}`}>
        <h2 id={`y${year}`}>{year}</h2>
        <PostList posts={posts.filter((p) => p.data.date.getUTCFullYear() === year)} headingLevel="h3" />
      </section>
    ))}
  </div>
</BaseLayout>

<style>
  .trail-wrap { margin-block: 3rem 1rem; }
  .year { margin-top: 3rem; }
  .year h2 { font-size: var(--step-1); color: var(--muted); font-weight: 600; margin-bottom: 0.5rem; font-variant-numeric: tabular-nums; }
</style>
