---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from './BaseLayout.astro';
import PageBanner from '../components/PageBanner.astro';
import { getCategory } from '../data/categories';
import { formatDate, readingTime } from '../lib/content';

interface Props {
  post: CollectionEntry<'posts'>;
  prev?: CollectionEntry<'posts'>;
  next?: CollectionEntry<'posts'>;
}
const { post, prev, next } = Astro.props;
const { title, description, date, updated, cover, coverAlt, tags } = post.data;
const cat = getCategory(post.data.category);
// Seed the ridges from the slug so every post gets its own skyline.
const seed = [...post.id].reduce((a, c) => a + c.charCodeAt(0), 0);
---
<BaseLayout title={title} description={description} overlayHeader image={cover?.src}>
  <article style={`--cat:${cat.color}`}>
    <PageBanner tint={cat.color} seed={seed}>
      <a class="cat-link" href={`/category/${cat.slug}/`}><span class="swatch" />{cat.name}</a>
      <h1>{title}</h1>
      <p class="meta">
        <time datetime={date.toISOString()}>{formatDate(date)}</time>
        <span>{readingTime(post.body)} min read</span>
        {updated && <span>Updated {formatDate(updated)}</span>}
      </p>
    </PageBanner>

    {cover && (
      <figure class="cover wrap">
        <Image src={cover} alt={coverAlt ?? ''} widths={[720, 1200, 1800]} sizes="(max-width: 72rem) 100vw, 72rem" />
      </figure>
    )}

    <div class="narrow prose body">
      <p class="lede">{description}</p>
      <slot />
    </div>

    {tags.length > 0 && (
      <ul class="narrow tags" aria-label="Tags">
        {tags.map((t) => <li>{t}</li>)}
      </ul>
    )}

    <nav class="narrow pager" aria-label="More posts">
      {prev ? <a class="prev" href={`/blog/${prev.id}/`}><span>Older</span>{prev.data.title}</a> : <span />}
      {next ? <a class="next" href={`/blog/${next.id}/`}><span>Newer</span>{next.data.title}</a> : <span />}
    </nav>
  </article>
</BaseLayout>

<style>
  .cat-link {
    display: inline-flex;
    align-items: center;
    gap: 0.55em;
    color: inherit;
    text-decoration: none;
    font-weight: 600;
    margin-bottom: 1rem;
  }
  .cat-link:hover { text-decoration: underline; }
  h1 {
    font-size: var(--step-4);
    font-weight: 750;
    max-width: 22ch;
    letter-spacing: -0.025em;
  }
  .meta { display: flex; flex-wrap: wrap; gap: 0.3rem 1.4rem; margin: 1.2rem 0 0; color: #c3d1d0; font-size: 0.98rem; }
  .cover { margin-top: 2.5rem; margin-bottom: 0; }
  .cover :global(img) { width: 100%; border-radius: var(--radius-lg); }
  .body { margin-top: 3rem; }
  .lede { font-size: 1.32rem; line-height: 1.5; color: var(--ink-soft); }
  .tags { list-style: none; padding: 0; margin-top: 3rem; display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .tags li { font-size: 0.88rem; padding: 0.25rem 0.7rem; border-radius: 999px; border: 1px solid var(--line); color: var(--ink-soft); }
  .pager {
    margin-top: 4rem;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
    border-top: 1px solid var(--line);
    padding-top: 1.5rem;
  }
  .pager a { display: grid; gap: 0.2rem; color: var(--ink); text-decoration: none; font-weight: 650; }
  .pager a span { color: var(--muted); font-weight: 500; font-size: 0.9rem; }
  .pager a:hover { color: var(--link); }
  .pager .next { text-align: right; }
</style>
